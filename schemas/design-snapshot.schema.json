{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "figma",
            "penpot",
            "local"
          ]
        },
        "instance_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "document_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "provenance": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "provider",
        "instance_url",
        "document_id",
        "version",
        "provenance"
      ]
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "node_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "viewport": {
            "$ref": "#/$defs/viewport"
          },
          "theme": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "locale": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "state": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "resource_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "export_scale": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "variant": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        },
        "required": [
          "id",
          "node_id",
          "label",
          "viewport",
          "theme",
          "locale",
          "state",
          "resource_id",
          "export_scale",
          "variant"
        ]
      },
      "minItems": 1
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "role": {
            "enum": [
              "reference",
              "image",
              "icon",
              "font",
              "tokens",
              "derived"
            ]
          },
          "artifact": {
            "$ref": "#/$defs/artifact"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "distribution": {
            "enum": [
              "allowed",
              "restricted",
              "unknown"
            ]
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "transform": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        },
        "required": [
          "id",
          "role",
          "artifact",
          "source",
          "distribution",
          "parent_id",
          "transform"
        ]
      },
      "minItems": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "snapshot_id",
    "captured_at",
    "source",
    "references",
    "resources",
    "limitations"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ggkguelensan.github.io/design-manifest/schemas/design-snapshot.schema.json",
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\:])[^\\s]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "media_type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/svg+xml",
            "application/json",
            "font/woff2",
            "application/octet-stream"
          ]
        }
      },
      "required": [
        "path",
        "sha256",
        "media_type"
      ]
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "width",
        "height"
      ]
    }
  }
}
